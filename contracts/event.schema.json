{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musekind.local/contracts/event.v0.1-draft.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "ts",
    "type",
    "goal_id"
  ],
  "properties": {
    "contract_version": {
      "const": "contract.v0.1-draft"
    },
    "event_id": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "dedupe_key": {
      "type": "string"
    }
  }
}

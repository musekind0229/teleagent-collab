{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musekind.local/contracts/goal.v0.1-draft.json",
  "title": "Goal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "goal_id",
    "title",
    "desired_outcome",
    "boundaries",
    "acceptance",
    "budget"
  ],
  "properties": {
    "contract_version": {
      "const": "contract.v0.1-draft"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must",
        "must_not"
      ],
      "properties": {
        "must": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_secret_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_gate_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_sec"
      ],
      "properties": {
        "wall_sec": {
          "type": "number",
          "minimum": 1
        },
        "max_reworks": {
          "type": "integer",
          "minimum": 0
        },
        "max_lead_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "max_usage": {
          "type": "number",
          "minimum": 0
        },
        "cost_hint": {
          "type": "string"
        }
      }
    },
    "role_hints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "capability_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "linux",
          "windows",
          "macos"
        ]
      },
      "description": "macos 可出现在名单中但实现必须返回 unsupported，不得按 linux 跑"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_charter_path": {
      "type": "string"
    },
    "forbidden_tools": {
      "type": "array",
      "description": "Explicit tool names banned at post-hoc acceptance after a tool has completed. Not OS isolation and not inferred from Goal wording. Unique, non-empty, at most 32.",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_inputs": {
      "type": "array",
      "description": "Optional pins so a Windows external_directory request can become a permission decision. At most 8 objects, each exactly an absolute path and a 64-hex SHA-256. Repo, hash, link, and size checks stay in the Windows charter validator. Absent means no pins. Backends that do not supervise external_directory ignore this field.",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional client snapshot record. Basename only; not a directory grant.",
            "required": ["kind", "source", "taken_at"],
            "properties": {
              "kind": {
                "enum": ["sqlite_snapshot", "file_snapshot"]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "taken_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          }
        }
      }
    },
    "input_manifest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit file list hashed by the client (content at hash time). Dispatch copies each entry into the task workspace and checks the hash again (content at run time). Not a recursive directory grant.",
      "required": ["root", "entries", "max_files", "max_total_bytes"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "max_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative", "sha256", "size"],
            "properties": {
              "relative": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}

# Example only. Copy to /etc/teleagent-collab/collab-service.env and chmod 600.
# Replace the placeholder. Never commit real tokens or TeleAgent local API keys.
COLLAB_API_TOKEN=replace-with-a-local-random-token

# Optional. Default when unset: http://127.0.0.1:4399
# Must stay http://127.0.0.1:<port> with no user, password, or path.
# TELEAGENT_URL=http://127.0.0.1:4399

# Optional. os.pathsep-separated TeleAgent image paths. Replaces the defaults
# (/opt/TeleAgent/teleagent and ~/.local/share/TeleAgent/runtimes/).
# A trailing slash or an existing directory is a prefix; anything else is exact.
# TELEAGENT_LINUX_IMAGES=/opt/TeleAgent/teleagent

# Leave the three local API keys unset so the service reads them from the
# logged-in TeleAgent process. Do not put real values in this example.
# OPENCODE_SERVER_USERNAME=
# OPENCODE_SERVER_PASSWORD=
# SUPER_AGENT_LOCAL_SESSION_KEY=
